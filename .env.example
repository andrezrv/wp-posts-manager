# WordPress site URL. When set, the login form skips the site address field.
# Leave empty to let users enter it manually.
VITE_WP_SITE_URL=

# Set to "true" to enable the mock server (demo mode).
# When "false" or unset, the app defaults to live mode.
VITE_MOCK_ENABLED=true

# Fallback posts per page when the WordPress settings endpoint is inaccessible.
# VITE_POSTS_PER_PAGE=10

# Maximum featured image file size in bytes (default: 5242880 = 5 MB).
# Should match the server's upload_max_filesize.
# VITE_MAX_IMAGE_BYTES=5242880

# Comma-separated MIME types accepted for featured images.
# VITE_ACCEPTED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Default status for new posts (publish, future, draft, pending, private).
# VITE_DEFAULT_POST_STATUS=draft

# Search input debounce delay in milliseconds.
# VITE_DEBOUNCE_DELAY_MS=350

# Post list sort field (date, modified, title) and direction (asc, desc).
# VITE_POSTS_ORDER_BY=date
# VITE_POSTS_ORDER=desc

# Maximum characters shown in the post list excerpt preview.
# VITE_EXCERPT_PREVIEW_LENGTH=160
